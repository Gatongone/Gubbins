<Project>
    <PropertyGroup Condition="'$(NativeAOT)' == 'true'">
        <DefineConstants>$(DefineConstants);NATIVEAOT;</DefineConstants>
    </PropertyGroup>

    <Target Name="PostBuild" BeforeTargets="PostBuildEvent" Condition="'$(IsTestProject)' != 'true' And '$(SkipDefaultPostBuild)' != 'true'">
        <PropertyGroup>
            <DotNetVer>$(TargetFramework)</DotNetVer>
            <UnitySupportVer>netstandard2.1</UnitySupportVer>
            <GodotSupportVer>net8.0</GodotSupportVer>
            <UnityOutDir>$(ProjectDir)..\Unity\Plugins</UnityOutDir>
            <GodotOutDir>$(ProjectDir)..\Godot\Plugins</GodotOutDir>
        </PropertyGroup>
        <ItemGroup>
            <OutputFiles Include="$(OutputPath)$(ProjectName).dll"/>
            <OutputFiles Include="$(OutputPath)$(ProjectName).pdb" Condition="Exists('$(OutputPath)$(ProjectName).pdb')"/>
            <OutputFiles Include="$(OutputPath)$(ProjectName).mdb" Condition="Exists('$(OutputPath)$(ProjectName).mdb')"/>
        </ItemGroup>
        <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(UnityOutDir)" SkipUnchangedFiles="true" Condition=" '$(UnityOutDir)' != '' and '$(DotNetVer)' == '$(UnitySupportVer)' "/>
        <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(GodotOutDir)" SkipUnchangedFiles="true" Condition=" '$(GodotOutDir)' != '' and '$(DotNetVer)' == '$(GodotSupportVer)' "/>
    </Target>

    <PropertyGroup>
        <GubbinsArtifactTool>$(MSBuildThisFileDirectory)Graphic\ArtifactTool\Gubbins.Graphic.Artifacts.csproj</GubbinsArtifactTool>
    </PropertyGroup>
    <PropertyGroup>
        <GubbinsArtifactTool>$(MSBuildThisFileDirectory)Graphic\ArtifactTool\Gubbins.Graphic.Artifacts.csproj</GubbinsArtifactTool>
    </PropertyGroup>

    <!-- A project that declares kernels with [GpuKernel] sets GubbinsKernels to true: the source generator translated them
         while the program compiled, and this step reads those programs back out of the assembly and runs slangc once per
         target, writing the artifacts beside the program where the generated entry points load them from. -->
    <Target Name="CompileGubbinsKernelArtifacts" AfterTargets="Build" Condition="'$(GubbinsKernels)' == 'true' And '$(TargetFramework)' == 'net8.0' And Exists('$(TargetPath)')">
        <Exec Command="dotnet run --project &quot;$(GubbinsArtifactTool)&quot; -c $(Configuration) -- --assembly &quot;$(TargetPath)&quot; --output &quot;$(OutDir)Kernels&quot;" />
    </Target>

</Project>
