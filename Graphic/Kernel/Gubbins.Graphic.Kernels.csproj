<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <RootNamespace>Gubbins.Graphic.Kernels</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <LangVersion>latestmajor</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <SkipDefaultPostBuild>true</SkipDefaultPostBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    </ItemGroup>

    <!-- The step that writes the artifacts of a kernel is a tool for the build, which the generator that reads a kernel
         has no use for: what it compiles into an analyzer is the translation and the emitters, and nothing that writes a
         file. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <Compile Remove="KernelCompiler.cs" />
    </ItemGroup>

</Project>
