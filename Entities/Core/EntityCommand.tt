using System.Runtime.CompilerServices;

namespace Gubbins.Entities;

/// <summary>
/// Provides the typed entity-command surface for unmanaged components.
/// </summary>
/// <remarks>
/// Every overload funnels into the single <see cref="IEntityCommand"/> entry point that takes a
/// <see cref="Components"/>, so the typed surface stays a thin, inlinable wrapper around one implementation.
/// </remarks>
public static class EntityCommandExtensions
{
    extension(IEntityCommand command)
    {
<#
    // Insert<T1..T16>: build the payload, hand it to the command.
    for (var n = 1; n <= 16; n++)
    {
        var generics = string.Join(", ", from index in Enumerable.Range(1, n) select $"T{index}");
        var parameters = string.Join(", ", from index in Enumerable.Range(1, n) select $"T{index} component{index}");
        var constraints = string.Join(" ", from index in Enumerable.Range(1, n) select $"where T{index} : unmanaged");
        var forwarded = string.Join(", ", from index in Enumerable.Range(1, n) select $"in component{index}");
#>
        /// <summary>
        /// Insert an entity with the specified components.
        /// </summary>
        public Entity Insert<<#= generics #>>(<#= parameters #>) <#= constraints #>
        {
            return command.Insert(Components.Create(<#= forwarded #>));
        }

<#
    }

    // Update<T1..T16>: write each component into the existing entity.
    for (var n = 1; n <= 16; n++)
    {
        var generics = string.Join(", ", from index in Enumerable.Range(1, n) select $"T{index}");
        var parameters = "Entity entity, " + string.Join(", ", from index in Enumerable.Range(1, n) select $"T{index} component{index}");
        var constraints = string.Join(" ", from index in Enumerable.Range(1, n) select $"where T{index} : unmanaged");
#>
        /// <summary>
        /// Updates the components data of a specific entity for a given component type.
        /// </summary>
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public void Update<<#= generics #>>(<#= parameters #>) <#= constraints #>
        {
<#
        for (var index = 1; index <= n; index++)
        {
#>
            command.Update(entity.Index, component<#= index #>);
<#
        }
#>
        }

<#
    }
#>
        /// <summary>
        /// Deletes the specified entity if its version is still current.
        /// </summary>
        public bool Delete(Entity entity) => command.Delete(entity.Index);

<#
    // InsertAll<T1..T16>: one payload, many entities.
    for (var n = 1; n <= 16; n++)
    {
        var generics = string.Join(", ", from index in Enumerable.Range(1, n) select $"T{index}");
        var parameters = "int count, " + string.Join(", ", from index in Enumerable.Range(1, n) select $"in T{index} component{index}");
        var constraints = string.Join(" ", from index in Enumerable.Range(1, n) select $"where T{index} : unmanaged");
        var forwarded = string.Join(", ", from index in Enumerable.Range(1, n) select $"in component{index}");
#>
        /// <summary>
        /// Insert <paramref name="count"/> entities that share the same component values.
        /// </summary>
        public void InsertAll<<#= generics #>>(<#= parameters #>) <#= constraints #>
            => command.InsertAll(count, Components.Create(<#= forwarded #>));

<#
    }
#>
    }
}
