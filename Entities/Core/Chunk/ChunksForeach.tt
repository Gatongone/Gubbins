/// <summary>
/// The read-only counterparts of <see cref="ElementForeach"/> and <see cref="SegmentForeach"/>: they take their
/// components as <c>in</c> references and <see cref="ReadOnlySpan{T}"/> spans, so an iteration cannot write through
/// them.
/// </summary>
/// <remarks>
/// The overloads that use them live on <see cref="ReadOnlyChunks"/>, not on <see cref="Chunks"/>, and share their names
/// with the write-side ones. Overloading the same receiver on the delegate type would not work: an action declared with
/// <c>in</c> parameters also converts to the <c>ref</c> delegate, so every call would be ambiguous. The receiver type is
/// what selects the access, and it is also what keeps a read from being marked as a change.
/// </remarks>
public delegate void ReadOnlyElementForeach(in Entity entity);
